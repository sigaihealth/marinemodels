<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#123f46"><title>Ventana V4277 · Detector comparison | SIG.AI Ocean</title>
<style>
:root{color-scheme:light;--ink:#163036;--tone:#4e666b;--rule:#bacac5;--page:#f4f5ee;--paper:#fffefa;--sea:#135961;--egg:#ffdf67;--eco:#30f0e0;--meg:#ff8ce9}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--page);font:16px/1.48 "Inter",Arial,sans-serif}header,main,footer{max-width:1150px;margin:auto;padding:0 clamp(16px,4vw,55px)}header{padding-top:28px;padding-bottom:20px;border-bottom:1px solid var(--rule)}h1,h2{font:normal clamp(34px,5vw,58px)/1.08 Georgia,serif;letter-spacing:-.025em;margin:10px 0}h2{font-size:clamp(26px,3vw,36px)}h3{margin:8px 0;font-size:18px}p{margin:6px 0 14px}a{color:var(--sea);text-underline-offset:2px}header a{font-weight:bold;text-decoration:none}header p{max-width:820px;margin-bottom:0}.block{margin:27px 0}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left;font-variant-numeric:tabular-nums}th,td{padding:9px 12px;border-bottom:1px solid var(--rule)}th{font-size:14px}th[scope=row]{font-size:15px}td{white-space:nowrap}.metrics th{background:#e8efea}.small{font-size:14px;color:var(--tone)}.tools{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.tools select{max-width:100%}button,select,textarea{font:inherit;color:inherit;border:1px solid #879f9d;border-radius:5px;padding:7px 10px;background:var(--paper)}button{cursor:pointer}button[aria-pressed=true]{background:var(--sea);color:#fff}button:disabled{opacity:.5;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,a:focus-visible{outline:3px solid #1d788e;outline-offset:2px}#cases{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}.canvas{position:relative;display:grid;place-items:center;background:#162c31;overflow:hidden;border-radius:6px}#viewbox{max-width:100%;position:relative}#photo{max-width:100%;max-height:62vh;width:auto;display:block}.canvas.zoom #photo{width:min(470px,90vw);height:auto;max-height:none}.canvas svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.layerbar{display:flex;gap:15px;align-items:center;flex-wrap:wrap;padding:12px 0}.layerbar label{font-size:14px}.sw{display:inline-block;width:.8em;height:.8em;border:1px solid #42545a;margin-right:5px}figure{margin:0}.casegrid{display:grid;grid-template-columns:minmax(0,1fr) minmax(225px,.34fr);gap:20px;align-items:start}aside{background:var(--paper);border:1px solid var(--rule);border-radius:5px;padding:12px 16px}aside label{display:block;margin-top:7px}aside select,aside textarea{width:100%}aside textarea{min-height:68px}.actions{display:flex;gap:8px;flex-wrap:wrap;padding:9px 0}.scroll{max-height:410px;overflow:auto}.scroll thead{position:sticky;top:0;background:var(--page)}details{margin:20px 0}summary{cursor:pointer;font-weight:650}footer{font-size:14px;color:var(--tone);padding-top:16px;padding-bottom:35px;border-top:1px solid var(--rule)}.muted{color:var(--tone)}@media(max-width:740px){.casegrid{grid-template-columns:1fr}th,td{padding:6px}#photo{max-height:48vh}}
</style><!-- ocean-nav-style:start -->
<style>
.ocean-header, .ocean-context {
  box-sizing: border-box;
  font: 500 1rem/1.45 "DM Sans", Arial, sans-serif;
  letter-spacing: normal;
  text-align: left;
}
.ocean-header { color: #f5f8f2; background: #092e34; border-bottom: 1px solid #46615e; }
.ocean-header .ocean-bar, .ocean-context .ocean-bar {
  box-sizing: border-box;
  width: min(78rem, calc(100% - clamp(2rem, 9vw, 9rem)));
  margin-inline: auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: .25rem 1.35rem;
}
.ocean-header .ocean-bar { justify-content: space-between; padding-block: .9rem; }
.ocean-header .ocean-brand {
  display: inline-flex; align-items: center; gap: .6rem; color: inherit;
  font: 700 1.38rem/1 "DM Sans", Arial, sans-serif; letter-spacing: -.065em;
  text-decoration: none; white-space: nowrap; min-height: 2.5rem;
}
.ocean-brand span { border-left: 1px solid #86a7a1; padding-left: .6rem; font: 400 1.6rem/1 "Instrument Serif", Georgia, serif; letter-spacing: -.035em; }
.ocean-header nav, .ocean-context nav {
  display: flex; flex-wrap: wrap; align-items: center;
  gap: .05rem clamp(.9rem, 2.2vw, 1.8rem); margin: 0; padding: 0;
}
.ocean-header nav a, .ocean-context nav a {
  display: inline-flex; align-items: center; min-height: 2.25rem; color: inherit;
  font: inherit; font-size: .96rem; text-decoration: none; white-space: nowrap;
}
.ocean-header nav a[aria-current] { color: #bce7d6; font-weight: 700; }
.ocean-header nav a[aria-current], .ocean-header nav a:hover, .ocean-context nav a:hover {
  text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3em;
}
.ocean-header a:focus-visible, .ocean-context a:focus-visible { outline: 3px solid #e7ae57; outline-offset: 3px; }
.ocean-context { background: #edf4ef; color: #294e48; border-bottom: 1px solid #c5d7cf; }
.ocean-context .ocean-bar { justify-content: space-between; padding-block: .25rem; }
.ocean-context nav { gap: .05rem .85rem; }
.ocean-context nav, .ocean-context nav a { font-size: .9rem; }
.ocean-context [aria-label="Breadcrumb"] a { text-decoration: underline; text-underline-offset: .18em; }
.ocean-context .ocean-separator { color: #65847b; }
.ocean-context .ocean-current, .ocean-context .ocean-local-label { font-weight: 650; }
.ocean-skip { position: absolute; left: .5rem; top: -7rem; padding: .6rem 1rem; z-index: 10; background: white; color: #163c36; }
.ocean-skip:focus { top: .5rem; }
@media (max-width: 46rem) {
  .ocean-header .ocean-bar { display: grid; gap: 0; padding-block: .45rem; }
  .ocean-header nav { column-gap: 1.05rem; }
  .ocean-header .ocean-brand { width: max-content; min-height: 2.125rem; }
  .ocean-context .ocean-bar { gap: 0 1rem; }
}
@media print { .ocean-header, .ocean-context, .ocean-skip { display: none; } }
</style>
<!-- ocean-nav-style:end -->
</head>
<body><a class="ocean-skip" href="#main">Skip to main content</a>
<!-- ocean-nav:start -->
<div class="ocean-header"><div class="ocean-bar">
  <a class="ocean-brand" href="https://ocean.sig.ai/" aria-label="SIG.AI Ocean home">SIG.AI<span>Ocean</span></a>
  <nav aria-label="Main navigation">
    <a href="https://ocean.sig.ai/world-model.html">World model</a>
    <a href="https://ocean.sig.ai/model-catalog.html">Model workspace</a>
    <a href="https://ocean.sig.ai/plankton-lab.html">Plankton lab</a>
    <a href="https://ocean.sig.ai/field-studies.html" aria-current="location">Field studies</a>
    <a href="https://ocean.sig.ai/collaborate.html">Contribute</a>
  </nav>
</div></div>
<div class="ocean-context"><div class="ocean-bar">
  <nav aria-label="Breadcrumb"><a href="https://ocean.sig.ai/field-studies.html">Field studies</a> <span class="ocean-separator" aria-hidden="true">/</span> <span class="ocean-current" aria-current="page">Ventana V4277</span></nav>
</div></div>
<!-- ocean-nav:end -->
<header><h1>Ventana V4277</h1><p>Compare Ecotype and Megalodon on the same 600 frames of MBARI’s Benthic Difficult transect. Follow a reference animal through the results and inspect where the detectors disagree.</p></header>
<main id="main"><section class="block" aria-labelledby="scoreTitle"><h2 id="scoreTitle">Detector coverage</h2><p id="summary"></p><div class="tablewrap"><table class="metrics"><thead><tr><th scope="col">Detector</th><th scope="col">Appearances localized</th><th scope="col">Tracks reached at least once</th><th scope="col">Median track coverage</th><th scope="col">Predictions matched</th></tr></thead><tbody id="metrics"></tbody></table></div><p class="small">Each location requires a one-to-one box match at IoU ≥ 0.50. Group names do not affect matching. Median coverage gives each reference track equal weight. A reference animal can appear in many frames.</p></section>
<section class="block" aria-labelledby="reviewTitle"><h2 id="reviewTitle">Review examples</h2><div class="tools"><label for="filter">Show</label><select id="filter"></select></div><div id="cases"></div><p id="empty" hidden></p>
<div id="casebody" class="casegrid"><figure><div class="canvas" id="canvas"><div id="viewbox"><img id="photo" alt=""><svg id="overlay" role="presentation"></svg></div></div>
<div class="layerbar"><button id="zoom" type="button" aria-pressed="false">Enlarge target</button><label><input type="checkbox" id="expert" checked><span class="sw" style="background:var(--egg)"></span>Reference</label><label><input type="checkbox" id="ecotype" checked><span class="sw" style="background:var(--eco)"></span>Ecotype</label><label><input type="checkbox" id="megalodon" checked><span class="sw" style="background:var(--meg)"></span>Megalodon</label></div><figcaption id="caption" class="small"></figcaption></figure>
<aside><h3 id="caseTitle"></h3><p id="caseText"></p><p id="diagnostic" class="small" hidden></p><p><a id="source" target="_blank" rel="noopener">Open original frame</a></p><label for="decision">Review decision</label><select id="decision"><option value="">Choose a decision</option><option>Agree with reference match</option><option>Possible annotation issue</option><option>Model located another animal</option><option>Needs expert review</option></select><label for="note">Reviewer note</label><textarea id="note"></textarea><div class="actions"><button id="save" type="button">Save review</button><button id="export" type="button">Export reviews</button></div><span id="status" class="small" role="status" aria-live="polite"></span></aside></div>
<p class="small">The reviewer shows up to three tracks for each agreement group. Shared misses prioritize individuals missed throughout the clip. Unmatched proposals are the highest-confidence candidates from distinct frames. The white outline marks the selected target. Review notes are stored in this browser and can be exported as JSON.</p></section>
<details><summary>Coverage by published taxon</summary><div class="tablewrap"><table><thead><tr><th>Expert label</th><th>Ecotype localized</th><th>Megalodon localized</th><th>Individuals missed by both</th></tr></thead><tbody id="taxa"></tbody></table></div></details>
<details><summary>Coverage of every expert track</summary><div class="scroll"><table><thead><tr><th>Track</th><th>Published label</th><th>Annotated frames</th><th>Ecotype matched</th><th>Megalodon matched</th></tr></thead><tbody id="tracks"></tbody></table></div></details>
<details><summary>Source and interpretation</summary><p>Use the per-frame and per-track measures for this dive. Counting an expert individual as reached measures detection coverage. Evaluating identity continuity or human review time requires a separate experiment. The earlier Ventana V4289 and OOI results are available in the <a href="https://ocean.sig.ai/visual-transect.html">pilot reviewer</a>.</p><p>Ground truth was initialized with MBARI’s 452k detector and ByteTrack and then manually reviewed, with missed organisms added and boxes adjusted. An unmatched model box is a candidate for visual review. <a href="https://arxiv.org/abs/2509.03499">Benchmark methods</a></p></details></main>
<footer>Imagery and expert annotations by Kevin Barnard, Elaine Liu, Kristine Walz, Brian Schlining, Nancy Jacobsen Stout and Lonny Lundsten, Monterey Bay Aquarium Research Institute. Selected images have been resized, cropped and overlaid for this review. The imagery and adaptations are available under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. <a href="https://huggingface.co/datasets/MBARI-org/DeepSea-MOT">DeepSea-MOT dataset</a>.</footer>
<script id="payload" type="application/json">__V4277_BUNDLE__</script>
<script>
const data=JSON.parse(document.getElementById("payload").textContent);
const $=id=>document.getElementById(id);
const metrics=data.metrics;
const names={ecotype:"Ecotype",megalodon:"Megalodon"};
const titles={neither:"Missed by both",ecotype_only:"Ecotype only",megalodon_only:"Megalodon only",both:"Localized by both",ecotype_unmatched:"Unmatched Ecotype proposals",megalodon_unmatched:"Unmatched Megalodon proposals"};
const pct=r=>r==null?"—":(100*r).toFixed(1)+"%";
const frac=(n,d)=>n.toLocaleString()+" / "+d.toLocaleString();
function cell(row,tag,value){const item=document.createElement(tag);item.textContent=value;row.append(item);return item}
function countGroup(g){return g.endsWith("_unmatched")?metrics.methods[g.split("_")[0]].unmatched_predictions:metrics.appearances_by_agreement[g]}
$("summary").textContent=metrics.reference_tracks.toLocaleString()+" expert tracks account for "+metrics.reference_appearances.toLocaleString()+" annotated appearances. Both detectors missed "+metrics.appearances_by_agreement.neither.toLocaleString()+" appearances under one-to-one matching. Across the full clip, "+metrics.tracks_by_ever_reached.neither+" expert tracks never received a one-to-one match from either detector.";
for (const [method,label] of Object.entries(names)){const s=metrics.methods[method],r=$("metrics").insertRow();cell(r,"th",label).scope="row";cell(r,"td",frac(s.matches,metrics.reference_appearances)+" · "+pct(s.appearance_recall));cell(r,"td",frac(s.tracks_reached,metrics.reference_tracks));cell(r,"td",pct(s.median_fraction_of_track_appearances_matched));cell(r,"td",frac(s.matches,s.predictions)+" · "+pct(s.prediction_match_rate))}
for (const [label,t] of Object.entries(metrics.by_published_taxon)){const r=$("taxa").insertRow();cell(r,"th",label).scope="row";cell(r,"td",frac(t.ecotype.matches,t.reference_appearances));cell(r,"td",frac(t.megalodon.matches,t.reference_appearances));cell(r,"td",frac(t.tracks_never_reached,t.reference_tracks))}
for (const t of data.tracks){const r=$("tracks").insertRow();cell(r,"th",t.track).scope="row";cell(r,"td",t.label);cell(r,"td",t.appearances);cell(r,"td",t.ecotype_matched);cell(r,"td",t.megalodon_matched)}
for (const [k,label] of Object.entries(titles)){const opt=document.createElement("option");opt.value=k;opt.textContent=label+" ("+countGroup(k).toLocaleString()+")";$("filter").append(opt)}
let group=Object.keys(titles).find(k=>data.groups[k].length)||"neither",index=0,zoom=false;
let reviews={};const storageKey="sigai:ventana:"+metrics.review_id;try{reviews=JSON.parse(localStorage.getItem(storageKey)||"{}")||{}}catch{}
function current(){return data.groups[group][index]}
function recordKey(){const c=current();return [group,c.frame_id,c.track??c.sighting_id].join("|")}
function renderControls(){const rows=data.groups[group];$("cases").replaceChildren();$("casebody").hidden=!rows.length;$("casebody").style.display=rows.length?"":"none";$("empty").hidden=!!rows.length;$("empty").textContent="There are no cases in this group.";rows.forEach((c,i)=>{const b=document.createElement("button");b.textContent=(c.track==null?"Proposal "+(i+1):"Track "+c.track)+" · "+c.timestamp.toFixed(2)+" s";b.setAttribute("aria-pressed",String(i===index));b.onclick=()=>{index=i;zoom=false;renderControls();render()};$("cases").append(b)})}
function displayPhoto(){const c=current();if(!c)return;const image=data.images[c.frame_id],view=zoom?c.crop.viewport:[0,0,image.width,image.height];const img=$("photo");img.src=zoom?c.crop.image:image.image;img.alt="Ventana V4277 source frame "+c.frame_index+(zoom?", enlarged target":"");$("zoom").setAttribute("aria-pressed",String(zoom));$("zoom").textContent=zoom?"Show full frame":"Enlarge target";$("canvas").classList.toggle("zoom",zoom);const svg=$("overlay");svg.setAttribute("viewBox",view.join(" "));svg.replaceChildren();function box(b,color,selected=false){const r=document.createElementNS("http://www.w3.org/2000/svg","rect");for(const [k,v] of Object.entries({x:b[0],y:b[1],width:b[2]-b[0],height:b[3]-b[1],stroke:color,fill:"none","stroke-width":selected?2:1.3,"vector-effect":"non-scaling-stroke"}))r.setAttribute(k,v);if(selected)r.setAttribute("stroke-dasharray","5 2");svg.append(r)}for(const [k,color] of [["expert","#ffdf67"],["ecotype","#30f0e0"],["megalodon","#ff8ce9"]])if($(k).checked)for(const obj of image.layers[k])box(obj.box,color);box(c.bbox,"white",true)}
function render(){const c=current();if(!c)return;displayPhoto();const title=c.track==null?names[c.method]+" proposal":c.label+" · track "+c.track;$("caseTitle").textContent=title;
$("caseText").textContent=c.track==null?"Confidence "+c.score.toFixed(3)+". The assignment found no matching expert box for this prediction. Check the frame for an unlabeled animal, an overlap or a localization error.":titles[group]+" on "+c.group_frames+" of this track’s "+c.track_frames+" annotated frames. "+(c.track_group==="neither"?"Neither detector received a one-to-one match for this individual anywhere in the clip.":"This individual was localized at least once by "+({both:"both detectors",ecotype_only:"Ecotype",megalodon_only:"Megalodon"}[c.track_group])+".");const d=data.miss_details.find(record=>record.track===c.track);
$("diagnostic").hidden=!d;
if(d){const counts=d.frames_with_any_box_at_iou_050;const overlaps=Object.entries(counts).filter(([,n])=>n>0).map(([method,n])=>names[method]+" had an overlapping proposal at IoU ≥ 0.50 on "+n+" frames. One-to-one matching assigned those proposals to other reference animals.");
$("diagnostic").textContent="Post-hoc overlap check. The median expert box measured "+Math.round(d.median_box_width_px)+" × "+Math.round(d.median_box_height_px)+" pixels in the original 1920 × 1080 image. "+(overlaps.length?overlaps.join(" "):"Neither detector proposed a box at IoU ≥ 0.50 in any of its "+d.appearances+" annotated frames.");}
$("caption").textContent="Frame "+c.frame_index+" of 600 · "+c.timestamp.toFixed(2)+" s from clip start.";
$("source").href="https://huggingface.co/datasets/MBARI-org/DeepSea-MOT/resolve/61ecbda8acb2749f3771d7192c51341267da2f37/data/BD/images/BD_"+String(c.frame_index).padStart(3,"0")+".jpg";const saved=reviews[recordKey()]||{};$("decision").value=saved.decision||"";$("note").value=saved.note||"";$("status").textContent=saved.decision?"Saved in this browser.":""}
$("filter").value=group;$("filter").onchange=()=>{group=$("filter").value;index=0;zoom=false;renderControls();render()};$("zoom").onclick=()=>{zoom=!zoom;displayPhoto()};for(const layer of ["expert","ecotype","megalodon"])$(layer).onchange=displayPhoto;
$("save").onclick=()=>{const c=current();if(!c||!$("decision").value){$("status").textContent="Choose a review decision.";return}reviews[recordKey()]={group,frame_id:c.frame_id,track_id:c.track??null,sighting_id:c.sighting_id??null,decision:$("decision").value,note:$("note").value.trim()};try{localStorage.setItem(storageKey,JSON.stringify(reviews));$("status").textContent="Saved in this browser."}catch{$("status").textContent="Saved for this visit. Export to keep your review."}};
$("export").onclick=()=>{const file=new Blob([JSON.stringify({review_id:metrics.review_id,reviews:Object.values(reviews)},null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(file);a.download="v4277-reviews.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
renderControls();render();
</script></body></html>
